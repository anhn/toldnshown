+/**
+ * Convert a VS Code-style glob (`*`, `**`, `?`, `{a,b}`, `[abc]` / `[!abc]`)
+ * into an anchored regular expression over forward-slash relative paths.
+ */
+export function globToRegExp(glob: string): RegExp {
+    return new RegExp(`^${globToRegExpSource(glob)}$`);
+}
+
+function globToRegExpSource(glob: string): string {
+    let out = '';
+    let i = 0;
+    while (i < glob.length) {
+        const c = glob[i];
+        if (c === '*') {
+            if (glob[i + 1] === '*') {
+                // Globstar: `**/` matches zero or more whole segments; a bare `**`
+                // matches anything (including slashes).
+                i += 2;
+                while (glob[i] === '*') i++;
+                if (glob[i] === '/') {
+                    out += '(?:.*/)?';
+                    i++;
+                } else {
+                    out += '.*';
+                }
+            } else {
+                out += '[^/]*';
+                i++;
+            }
+        } else if (c === '?') {
+            out += '[^/]';
+            i++;
+        } else if (c === '{') {
+            // Find the matching close brace and split on top-level commas.
+            let depth = 0;
+            let j = i;
+            const parts: string[] = [];
+            let start = i + 1;
+            for (; j < glob.length; j++) {
+                if (glob[j] === '{') depth++;
+                else if (glob[j] === '}') {
+                    depth--;
+                    if (depth === 0) break;
+                } else if (glob[j] === ',' && depth === 1) {
+                    parts.push(glob.slice(start, j));
+                    start = j + 1;
+                }
+            }
+            if (j >= glob.length) {
+                out += '\\{'; // unbalanced — treat literally
+                i++;
+                continue;
+            }
+            parts.push(glob.slice(start, j));
+            out += `(?:${parts.map(globToRegExpSource).join('|')})`;
+            i = j + 1;
+        } else if (c === '[') {
+            const close = glob.indexOf(']', i + 2);
+            if (close === -1) {
+                out += '\\[';
+                i++;
+                continue;
+            }
+            let body = glob.slice(i + 1, close);
+            let negate = false;
+            if (body.startsWith('!') || body.startsWith('^')) {
+                negate = true;
+                body = body.slice(1);
+            }
+            body = body.replace(/[\\\]^]/g, '\\$&');
+            out += negate ? `[^/${body}]` : `[${body}]`;
+            i = close + 1;
+        } else {
+            out += c.replace(/[.+^$()|\\/]/g, '\\$&');
+            i++;
+        }
+    }
+    return out;
+}
