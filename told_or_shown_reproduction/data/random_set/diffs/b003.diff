+        if (!g.includes('/')) g = `**/${g}`;
+        let suffix = '';
+        if (g.endsWith('/**')) {
+            g = g.slice(0, -3);
+            suffix = '(?:/.*)?';
+        }
+        regexes.push(new RegExp(`^${globBodyToRegExpSource(g)}${suffix}$`));
+    }
+    return (relPath: string) => regexes.some(re => re.test(relPath));
+}
